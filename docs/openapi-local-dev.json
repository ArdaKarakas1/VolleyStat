  "components": {
    "schemas": {
      "DecisionInput": {
        "properties": {
          "selection": {
            "type": "string",
            "title": "Selection"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expectedversion"
          },
          "idempotencyKey": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotencykey"
          }
        },
        "type": "object",
        "required": [
          "selection",
          "expectedVersion"
        ],
        "title": "DecisionInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MatchInput": {
        "properties": {
          "homeTeamName": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Hometeamname"
          },
          "awayTeamName": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Awayteamname"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "playedOn": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Playedon"
          },
          "venue": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue"
          },
          "kind": {
            "type": "string",
            "enum": [
              "TRAINING",
              "OFFICIAL"
            ],
            "title": "Kind",
            "default": "TRAINING"
          }
        },
        "type": "object",
        "required": [
          "homeTeamName",
          "awayTeamName"
        ],
        "title": "MatchInput"
      },
      "ReopenInput": {
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expectedversion"
          }
        },
        "type": "object",
        "required": [
          "expectedVersion"
        ],
        "title": "ReopenInput"
      },
      "UploadInput": {
        "properties": {
          "fileName": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename"
          },
          "sizeBytes": {
            "type": "integer",
            "maximum": 4294967296.0,
            "exclusiveMinimum": 0.0,
            "title": "Sizebytes"
          },
          "mimeType": {
            "type": "string",
            "title": "Mimetype"
          },
          "rightsAttested": {
            "type": "boolean",
            "title": "Rightsattested"
          },
          "allowTraining": {
            "type": "boolean",
            "title": "Allowtraining",
            "default": false
          },
          "clientSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clientsha256"
          }
        },
        "type": "object",
        "required": [
          "fileName",
          "sizeBytes",
          "mimeType",
          "rightsAttested"
        ],
        "title": "UploadInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
