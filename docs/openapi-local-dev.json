  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MatchInput": {
        "properties": {
          "homeTeamName": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Hometeamname"
          },
          "awayTeamName": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Awayteamname"
          }
        },
        "type": "object",
        "required": [
          "homeTeamName",
          "awayTeamName"
        ],
        "title": "MatchInput"
      },
      "UploadInput": {
        "properties": {
          "fileName": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename"
          },
          "sizeBytes": {
            "type": "integer",
            "maximum": 4294967296.0,
            "exclusiveMinimum": 0.0,
            "title": "Sizebytes"
          },
          "mimeType": {
            "type": "string",
            "title": "Mimetype"
          },
          "rightsAttested": {
            "type": "boolean",
            "title": "Rightsattested"
          },
          "allowTraining": {
            "type": "boolean",
            "title": "Allowtraining",
            "default": false
          },
          "clientSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clientsha256"
          }
        },
        "type": "object",
        "required": [
          "fileName",
          "sizeBytes",
          "mimeType",
          "rightsAttested"
        ],
        "title": "UploadInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
